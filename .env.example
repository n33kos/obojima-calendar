# Calendar Data Configuration
# Copy this file to .env and fill in your values

# URL to fetch JSON calendar data from (e.g., raw GitHub file, Gist raw URL, or any JSON endpoint)
VITE_CALENDAR_DATA_URL=https://raw.githubusercontent.com/your-username/your-repo/main/data.json

# Optional: Auto-refresh interval in milliseconds (default: 60000 = 1 minute)
VITE_CALENDAR_REFRESH_INTERVAL=60000
